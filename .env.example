# Copy this file to .env and fill in your values.

# ---- Gemini (optional: without a key the app runs rules-only) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is overloaded or rate-limited (429/5xx)
# after a couple of quick retries. Set empty to disable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ---- Database ----
# Local Postgres (driver: psycopg). Leave DATABASE_URL unset to use a local
# SQLite file at backend/data/app.db instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/loan_check

# Apply Alembic migrations automatically on app startup (default true).
# Set false to run `alembic upgrade head` manually instead.
# AUTO_MIGRATE=true

# Where uploaded documents are stored (default: backend/data/uploads)
# UPLOAD_DIR=/var/lib/loan-check/uploads

# ---- Security ----
# Secret mixed into password and session-token hashes. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates every existing password and login session.
PASSWORD_HASH_SECRET=change-me-to-a-long-random-string
# Login session lifetime in hours
TOKEN_TTL_HOURS=72

# ---- Admin (loan officer) account, created on startup if missing ----
ADMIN_EMAIL=admin@loancheck.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Loan Officer

# ---- CORS ----
# Extra comma-separated origins for a deployed frontend that calls the backend
# directly via VITE_BACKEND_URL. localhost:5173 is always allowed.
# ALLOWED_ORIGINS=https://my-app.vercel.app

# Optional backup LLM: Meta Llama API, tried when Gemini fails.
# Key format: LLM|<id>|<secret>  (from https://llama.developer.meta.com)
META_API_KEY=
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# Order of providers to try (default: gemini,meta)
# LLM_PROVIDERS=gemini,meta
