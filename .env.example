# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash

# Extra CORS origins (comma-separated) for a deployed frontend that calls the
# backend directly via VITE_BACKEND_URL. Localhost:5173 is always allowed.
# ALLOWED_ORIGINS=https://my-app.vercel.app
